      <property name="styleSheet">
       <string notr="true">#TabWidget, QTabWidget::pane{
	background-color: rgba(255, 255, 255, 100);
}

#TabWidget QTabBar::tab
{
	background-color: rgba(150, 150, 150, 200);
	border:1px solid #34495e;
	
	color: rgb(0, 0, 0);
	font: 75 11pt &quot;微软雅黑&quot;;
	border-radius:5px;
    min-width: 120px;
	min-height:28px;
	border-bottom-right-radius:0px;
	border-bottom-left-radius:0px;
	margin-left: 1px;
}


#TabWidget QTabBar::tab:selected
{
	background-color: rgba(231, 76, 60, 200);
	border:1px solid rgb(208, 66, 54);
}

#TabWidget QTabBar::tab:hover
{
	background-color: rgba(231, 76, 60, 120);
	border:1px solid rgb(208, 66, 54);
	cursor:pointer;
}

#TabWidget QTabBar::tab:!selected
{
    margin-top: 2px; 
}</string>
