            <property name="styleSheet">
             <string notr="true">/* 默认状态 - 未按下且未悬停 */
QPushButton {
    font: 13pt &quot;微软雅黑&quot;;
    border-radius: 25px;
    color: rgb(10, 10, 10);
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(255, 170, 127, 200), 
        stop:1 rgba(255, 225, 255, 255));
}

/* 悬停状态 - 鼠标悬停但未按下 */
QPushButton:hover {
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(235, 150, 107, 230),   /* 更深的橙色 */
        stop:1 rgba(235, 195, 235, 255));  /* 更深的浅紫色 */
}

/* 按下状态 - 鼠标按下 */
QPushButton:pressed {
    background-color: qlineargradient(spread:repeat, x1:0, y1:0, x2:1, y2:0, 
        stop:0 rgba(220, 135, 90, 255),    /* 更深的橙褐色 */
        stop:1 rgba(220, 180, 220, 255));  /* 更深的紫灰色 */

}</string>
